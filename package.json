{
  "name": "evenhub-app-ui",
  "version": "1.1.0",
  "description": "Even Hub mobile app design system and pixel icons for AI coding agents",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JustinasLa/evenhub-app-ui.git"
  },
  "bin": {
    "install-evenhub-app-ui": "./bin/install.js"
  },
  "files": [
    ".claude-plugin/",
    ".codex-plugin/",
    "bin/",
    "skills/",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "c8 node --test"
  },
  "c8": {
    "all": true,
    "include": ["**/*.js", "**/*.mjs", "**/*.cjs"],
    "exclude": ["test/**", "test-support/**", "node_modules/**", "coverage/**"],
    "reporter": ["text", "html", "lcov", "json-summary"],
    "check-coverage": true,
    "lines": 100,
    "statements": 100,
    "functions": 100,
    "branches": 100
  },
  "devDependencies": {
    "c8": "^10.1.3"
  }
}
